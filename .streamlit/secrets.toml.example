# Copie este conteúdo para a área "Secrets" do Streamlit Community Cloud.
# Nunca renomeie este arquivo para secrets.toml nem preencha uma chave real no Git.
GOOGLE_API_KEY = "COLE_SUA_CHAVE_GEMINI_AQUI"
GEMINI_MODEL = "gemini-3.6-flash"
EMBEDDING_MODEL = "gemini-embedding-2"
EMBEDDING_DIMENSION = "768"
CHROMA_COLLECTION = "nrv_informatica"
CHROMA_DIR = "/tmp/nrv_chroma"
RAG_TOP_K = "4"
AUTO_BUILD_CHROMA = "true"
EXCEL_FILE = "data/Tabela_Servicos_NRV.xlsx"
